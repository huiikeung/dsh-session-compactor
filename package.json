{
  "name": "@dsh-external/dsh-context-compactor",
  "version": "0.6.10",
  "description": "DSH 上下文压缩/总结 + 提示增强 合并插件，并整合《DSH 5 个补丁》：80% 阈值自动【全局详细总结】压缩（保留：核心任务与进度、关键决策及理由、待解决问题、重要文件/代码位置；删除：调试过程、已解决错误、客套话与重复；旧 checkpoint 全局合并），【压缩后验】每次压缩必须实际降低 totalTokens；补丁联动：超大工具结果压缩前分块落盘防丢(>200KB)、压力感知压缩深度(>0.9 压得更狠)、每日定时反思(非破坏性全局摘要 → reflections/)、工具截断追踪(truncations.jsonl)；context-overflow 自动恢复重试、工具结果裁剪、/compact、/reflect、/truncations、/enhance-prompt、/context-status 命令与「压缩总结」+「提示增强」输入框按钮",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "index.js",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-compaction": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-token-meter": ">=0.1.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs",
    "prepare": "bash scripts/build.sh",
    "prepack": "bash scripts/build.sh"
  }
}
